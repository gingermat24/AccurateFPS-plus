		{
			"config": "accuratefpsplus.sodium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config2": "*",
		"yet_another_config_lib_v3": "*",
		"modmenu": "*",
		"sodium": "*",
		"sodiumfpscapfix": "*",
		"iris": "*",
		"immediatelyfast": "*"
	}
}