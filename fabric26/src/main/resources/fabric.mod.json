{
	"schemaVersion": 1,
	"id": "accuratefpsplus",
	"version": "${version}",
	"name": "AccurateFPS+",
	"description": "Lightweight, configurable performance HUD with precise FPS telemetry.",
	"authors": ["gingermat"],
	"license": "MIT",
	"environment": "client",
	"contact": {
		"homepage": "https://modrinth.com/mod/accuratefpsplus",
		"issues": "https://github.com/gingermat24/AccurateFPS-plus/issues"
	},
	"custom": {
		"modmenu": {
			"links": {
				"Modrinth": "https://modrinth.com/mod/accuratefpsplus"
			}
		}
	},
	"accessWidener": "accuratefpsplus.accesswidener",
	"icon": "assets/accuratefpsplus/icon.png",
	"entrypoints": {
		"client": ["com.accuratefpsplus.AccurateFpsPlusFabricClient"],
		"modmenu": ["com.accuratefpsplus.modmenu.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "${client_mixin_config}",
			"environment": "client"
		},
		{
			"config": "accuratefpsplus.sodium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version_constraint}",
		"java": ">=25"
	},
	"suggests": {
		"cloth-config2": "*",
		"yet_another_config_lib_v3": "*",
		"modmenu": "*",
		"sodium": "*",
		"sodiumfpscapfix": "*",
		"iris": "*",
		"immediatelyfast": "*"
	}
}
